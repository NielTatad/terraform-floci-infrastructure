# .env.example
#
# Copy this file to .env for use with the scripts/ automation.
# .env is excluded from Git — never commit it.
#
# These are intentional dummy credentials for Floci (local AWS emulator).
# Floci accepts any non-empty string as access key and secret key.
# Do NOT replace these with real AWS credentials.

# ---------------------------------------------------------------------------
# AWS / Floci credentials
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Floci endpoint
# ---------------------------------------------------------------------------
# All AWS SDK and CLI calls are redirected here.
AWS_ENDPOINT_URL=http://localhost:4566

# ---------------------------------------------------------------------------
# Optional: AWS CLI named profile (see README for setup instructions)
# ---------------------------------------------------------------------------
# AWS_PROFILE=floci
