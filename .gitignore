# =============================================================================
# Terraform
# =============================================================================

# Local state files — never commit these.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output files.
*.tfplan

# Terraform working directories — regenerated by terraform init.
**/.terraform/
**/.terraform.lock.hcl.bak

# Crash logs.
crash.log
crash.*.log

# Variable files that may contain sensitive values.
# Commit terraform.tfvars.example; never commit terraform.tfvars itself.
terraform.tfvars
*.auto.tfvars

# Override files — local developer customisations, not shared.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =============================================================================
# Environment / credentials
# =============================================================================

# Local credentials — only .env.example is committed.
.env
.env.*
!.env.example

# =============================================================================
# Floci
# =============================================================================

# Persisted Floci state directory (created by Docker volume mount).
floci/data/

# =============================================================================
# OS / editor noise
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VSCode / Cursor
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# Vim swaps
*.swp
*.swo

# =============================================================================
# Logs
# =============================================================================
*.log
logs/
