# terraform.tfvars.example — copy to terraform.tfvars and adjust as needed.
# terraform.tfvars is excluded from Git.

floci_endpoint = "http://localhost:4566"
aws_region     = "us-east-1"
aws_access_key = "test"
aws_secret_key = "test"

environment = "local"
project     = "floci-eks"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]
enable_nat_gateway   = true

# EKS
cluster_name       = "floci-eks-cluster"
kubernetes_version = "1.31"

# Node Group
nodegroup_name      = "floci-eks-nodes"
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
node_instance_types = ["t3.medium"]

# ECR
ecr_repository_name = "floci-eks-app"

# CloudWatch
log_retention_days = 7
