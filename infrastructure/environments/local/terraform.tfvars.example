# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and adjust as needed.
# terraform.tfvars is excluded from Git (.gitignore) because it may contain
# environment-specific values. Use this example as the committed reference.
#
# NOTE: All credential values here are intentional dummy values for Floci.
#       Never put real AWS credentials in any tfvars file.

# ---------------------------------------------------------------------------
# Floci / provider
# ---------------------------------------------------------------------------
floci_endpoint = "http://localhost:4566"
aws_region     = "us-east-1"

# Dummy credentials — Floci accepts any non-empty string.
# Do not change these to real AWS keys.
aws_access_key = "test"
aws_secret_key = "test"

# ---------------------------------------------------------------------------
# Environment metadata
# ---------------------------------------------------------------------------
environment = "local"
project     = "floci-demo"

# ---------------------------------------------------------------------------
# S3
# ---------------------------------------------------------------------------
s3_bucket_name       = "floci-demo-bucket"
s3_enable_versioning = true

# ---------------------------------------------------------------------------
# DynamoDB
# ---------------------------------------------------------------------------
dynamodb_table_name   = "floci-demo-table"
dynamodb_hash_key     = "id"
dynamodb_billing_mode = "PAY_PER_REQUEST"

# ---------------------------------------------------------------------------
# SQS
# ---------------------------------------------------------------------------
sqs_queue_name         = "floci-demo-queue"
sqs_visibility_timeout = 30
